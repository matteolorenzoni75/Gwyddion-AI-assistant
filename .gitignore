# Generated / large
__pycache__/
*.pyc
.venv/
out/
*.egg-info/

# Synthetic datasets: the .gwy pairs are large (~1 MB per sample) and fully
# reproducible from tools/make_dataset.py given the seed recorded in
# summary.json. Track the labels and the summary, not the pixels.
data/**/clean/
data/**/degraded/
data/smoketest/

# Keep the API inventory and the data survey - they are deliverables,
# not build artifacts.

# The map from scan-0NN back to the original filenames. Those names carry
# collaborators' names and unpublished samples, and this repository is public.
# It stays on the machine that made the corpus; export/scans/ itself is
# committed, and nothing in it can be traced back without this file.
export/original-names.json
